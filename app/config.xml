  <tizen:application id="SUNIKOHOME.SunikoHome" package="SUNIKOHOME" required_version="6.5"/>
  <name>Suniko Home</name>
  <description>A calm, glanceable home screen for Samsung TVs: clock, live-sky weather, SmartThings home, prayer times and a developer hub.</description>
  <author href="https://github.com/onlyilkr">İlker Güldalı</author>
  <license href="https://opensource.org/licenses/MIT">MIT</license>
  <icon src="icon.png"/>
  <content src="index.html"/>
