  <access origin="https://api.open-meteo.com" subdomains="false"/>
  <access origin="https://ipwho.is" subdomains="false"/>
  <access origin="https://api.smartthings.com" subdomains="false"/>
  <access origin="https://ezanvakti.emushaf.net" subdomains="false"/>
  <access origin="https://api.aladhan.com" subdomains="false"/>
